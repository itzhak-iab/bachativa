rules_version = '2';

// Firestore rules for bachativa.com — public read, admin-only writes
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          'i.barkai7@gmail.com',
          'bachativa@gmail.com'
        ];
    }

    match /articles/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /authors/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /issues/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /newsletters/{id} { allow read: if true; allow write: if isAdmin(); }
    match /magazines/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /videos/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /{document=**}    { allow read, write: if false; }
  }
}
