rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Anyone can read /uploads/**; only admins can write (limited to 10MB)
    match /uploads/{path=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in ['i.barkai7@gmail.com','bachativa@gmail.com']
        && request.resource.size < 10 * 1024 * 1024;
    }
    // Default deny
    match /{path=**} { allow read, write: if false; }
  }
}
